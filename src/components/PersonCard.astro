---
import { url } from '../lib/url';

interface Props {
  person: {
    name: string;
    role: string;
    team?: string;
    major?: string;
    gradYear?: number | string;
    photo?: string;
    linkedin?: string;
  };
  index?: number;
}
const { person, index = 0 } = Astro.props;
const tilt = [-2, 1.5, -1, 2][index % 4];
const initials = person.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const yr = person.gradYear ? `'${String(person.gradYear).slice(-2)}` : '';
---

<article class="person">
  <div class="cutout" style={`--tilt:${tilt}deg`}>
    {
      person.photo ? (
        <img src={url(person.photo)} alt={person.name} loading="lazy" />
      ) : (
        <div class="initials" aria-hidden="true">{initials}</div>
      )
    }
  </div>
  <h3>{person.name}</h3>
  <p class="role hand">{person.role}</p>
  <p class="meta">
    {person.major}{yr && ` · ${yr}`}
    {person.team && <><br />{person.team}</>}
  </p>
  {
    person.linkedin && (
      <a class="li" href={person.linkedin} target="_blank" rel="noopener">
        LinkedIn ↗
      </a>
    )
  }
</article>

<style>
  .person { text-align: center; }
  .cutout {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1;
    margin: 0 auto 16px;
    background: #fff;
    padding: 8px;
    transform: rotate(var(--tilt));
    box-shadow: 0 10px 22px -12px rgba(29, 36, 51, 0.4);
    transition: transform 0.2s ease;
  }
  .person:hover .cutout { transform: rotate(0deg); }
  .cutout img, .initials {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
  }
  .initials {
    display: grid;
    place-items: center;
    background: var(--paper-2);
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--navy);
  }
  h3 { font-size: 1.25rem; margin: 0; text-transform: none; }
  .role { margin: 2px 0 6px; font-size: 1.45rem; }
  .meta { font-size: 0.95rem; color: var(--ink-soft); margin: 0 0 6px; }
  .li { font-size: 0.9rem; font-weight: 600; }
</style>
