---
import { url } from '../lib/url';

interface Props {
  person: {
    name: string;
    role: string;
    team?: string;
    major?: string;
    gradYear?: number | string;
    photo?: string;
    linkedin?: string;
  };
  index?: number;
}
const { person, index = 0 } = Astro.props;
const tilt = [-2, 1.5, -1, 2][index % 4];
const initials = person.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
// Transparent PNG headshots (background removed) render as stickers instead of framed squares.
const isCutout = /\.png$/i.test(person.photo || '');
const meta = [person.major, person.gradYear && `class of ${person.gradYear}`].filter(Boolean).join(', ');
---

<article class="person">
  <div class:list={['cutout', { sticker: isCutout, 'is-sticker': isCutout }]} style={`--tilt:${tilt}deg`}>
    {
      person.photo ? (
        <img src={url(person.photo)} alt={person.name} loading="lazy" />
      ) : (
        <div class="initials" aria-hidden="true">{initials}</div>
      )
    }
  </div>
  <h3>{person.name}</h3>
  <p class="role note">{person.role}</p>
  {meta && <p class="meta">{meta}</p>}
  {
    person.linkedin && (
      <a class="li" href={person.linkedin} target="_blank" rel="noopener">
        LinkedIn
      </a>
    )
  }
</article>

<style>
  .person { text-align: center; }
  .cutout {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1;
    margin: 0 auto 16px;
    background: var(--white);
    padding: 8px;
    transform: rotate(var(--tilt));
    box-shadow: 0 10px 22px -12px rgba(22, 50, 74, 0.4);
  }
  .cutout.is-sticker { background: none; padding: 0; box-shadow: none; }
  .cutout.is-sticker img { object-fit: contain; object-position: bottom; filter: none; }
  .cutout img, .initials {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    filter: grayscale(0.15);
  }
  .initials {
    display: grid;
    place-items: center;
    background: var(--concrete);
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--ink);
  }
  h3 { font-size: 1.4rem; margin: 0; }
  .role { margin: 4px auto 4px; color: var(--ink); }
  .meta { font-size: 0.95rem; color: var(--steel); margin: 0 auto 6px; }
  .li { font-size: 0.95rem; font-weight: 500; }
</style>
