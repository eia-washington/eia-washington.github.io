---
// A "taped to the page" photo, scrapbook style.
// If `src` is empty it shows a placeholder so pages still look right before real photos exist.
import { url } from '../lib/url';

interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  tilt?: number;   // degrees, e.g. -2 or 3
  tape?: boolean;
  ratio?: string;  // CSS aspect-ratio, e.g. "4 / 3"
}
const { src = '', alt = '', caption, tilt = 0, tape = true, ratio = '4 / 3' } = Astro.props;
---

<figure class="photo" style={`--tilt:${tilt}deg; --ratio:${ratio}`}>
  {tape && <span class="tape" aria-hidden="true"></span>}
  {
    src ? (
      <img src={url(src)} alt={alt || caption || ''} loading="lazy" />
    ) : (
      <div class="placeholder" role="img" aria-label={alt || caption || 'Photo coming soon'}>
        <span>Photo coming soon</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
    background: var(--white);
    padding: 10px 10px 14px;
    box-shadow: 0 12px 24px -14px rgba(22, 50, 74, 0.45);
    transform: rotate(var(--tilt));
    position: relative;
  }
  img, .placeholder {
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(45deg, var(--concrete) 0 12px, var(--paper) 12px 24px);
    color: var(--steel);
    font-family: var(--font-hand);
    font-size: 1.05rem;
  }
  figcaption {
    font-family: var(--font-hand);
    font-size: 1.05rem;
    color: var(--ink);
    text-align: center;
    margin-top: 8px;
    line-height: 1.25;
  }
  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 96px;
    height: 26px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(221, 214, 190, 0.85);
    z-index: 1;
  }
</style>
