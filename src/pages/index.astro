---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';
import site from '../data/site.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = projects[0];
const tilts = [-2.5, 2, -1, 1.5];
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">engineers in action · uw</span>
      <h1>
        bridges that<br />
        <span class="underline">get people</span> there.
      </h1>
      <p class="lede">{site.tagline}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/sponsor')}>sponsor us</a>
        <a class="btn" href={url('/join')}>join the team</a>
        <a class="btn" href={url('/projects')}>read about past bridges</a>
      </div>
      <p class="scroll hand"><a href="#purpose">scroll down ↓</a></p>
    </div>
  </section>

  <!-- PURPOSE -->
  <section id="purpose" class="band">
    <div class="wrap split">
      <div>
        <span class="eyebrow">what we do</span>
        <h2>a river shouldn't decide if you get to school.</h2>
        <p class="lede">{site.purpose}</p>
        <div class="stats">
          {site.stats.map((s) => <div class="stat"><strong>{s.value}</strong><span>{s.label}</span></div>)}
        </div>
      </div>
      <div class="collage">
        <Photo src={latest?.data.cover} caption="the crossing before" tilt={-3} />
        <Photo src={latest?.data.photos[0]?.src} caption="and after" tilt={2.5} />
      </div>
    </div>
  </section>

  <!-- LATEST PROJECT -->
  {
    latest && (
      <section id="latest">
        <div class="wrap">
          <span class="eyebrow">our most recent project</span>
          <h2>{latest.data.title}</h2>
          <p class="lede">
            {latest.data.community}, {latest.data.country} ·{' '}
            {latest.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
          </p>

          <div class="latest-stats stats">
            {latest.data.peopleServed && (
              <div class="stat">
                <strong>{latest.data.peopleServed.toLocaleString()}</strong>
                <span>people served</span>
              </div>
            )}
            {latest.data.spanMeters && (
              <div class="stat">
                <strong>{latest.data.spanMeters}m</strong>
                <span>span</span>
              </div>
            )}
            {latest.data.travelers.length > 0 && (
              <div class="stat">
                <strong>{latest.data.travelers.length}</strong>
                <span>students traveled</span>
              </div>
            )}
          </div>

          <div class="photo-strip">
            {latest.data.photos.map((p, i) => (
              <Photo src={p.src} caption={p.caption} tilt={tilts[i % tilts.length]} />
            ))}
          </div>

          {latest.data.quotes.length > 0 && (
            <div class="quotes">
              {latest.data.quotes.map((q) => (
                <blockquote>
                  <p>“{q.text}”</p>
                  <cite>
                    <span class="hand">{q.name}</span>
                    {q.role && <small>{q.role}</small>}
                  </cite>
                </blockquote>
              ))}
            </div>
          )}

          {latest.data.travelers.length > 0 && (
            <p class="travelers">
              <span class="hand">who went:</span> {latest.data.travelers.join(', ')}
            </p>
          )}

          <a class="btn" href={url(`/projects/${latest.id}`)}>read the full story →</a>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="band-dark cta">
    <div class="wrap split">
      <div>
        <span class="eyebrow">come build with us</span>
        <h2>no engineering experience required.</h2>
        <p>We need designers, writers, fundraisers, planners, and people who just want to help.</p>
        <div class="btn-row">
          <a class="btn" href={url('/join')}>join the team</a>
        </div>
      </div>
      <div>
        <span class="eyebrow">interested in our mission?</span>
        <h2>help us fund the next bridge.</h2>
        <p>Every bridge is paid for by sponsors and donors. See where your support goes.</p>
        <div class="btn-row">
          <a class="btn" href={url('/sponsor')}>sponsor us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(48px, 10vw, 120px); }
  .hero h1 { max-width: 14ch; }
  .underline {
    position: relative;
    z-index: 0;
    white-space: nowrap;
  }
  .underline::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0.05em;
    height: 0.28em;
    background: var(--accent);
    opacity: 0.35;
    border-radius: 40% 60% 50% 50%;
    transform: rotate(-1.2deg);
    z-index: -1;
  }
  .hero .lede { margin: 18px 0 28px; }
  .scroll { margin-top: 48px; }
  .scroll a { text-decoration: none; color: var(--accent); }

  .collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  .collage > :last-child { margin-top: 48px; }

  .latest-stats { margin: 28px 0 48px; }

  .photo-strip {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-bottom: 56px;
  }

  .quotes {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-bottom: 32px;
  }
  blockquote {
    margin: 0;
    padding: 24px;
    background: #fff;
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
  }
  blockquote p { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.35; }
  cite { font-style: normal; display: flex; flex-direction: column; }
  cite .hand { font-size: 1.5rem; }
  cite small { color: var(--ink-soft); }

  .travelers { margin-bottom: 28px; }
  .travelers .hand { font-size: 1.5rem; margin-right: 6px; }

  .cta .split { align-items: start; }
  @media (min-width: 860px) { .cta .split { grid-template-columns: 1fr 1fr; } }
  .cta h2 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); }
</style>
