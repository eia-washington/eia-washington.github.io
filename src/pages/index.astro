---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import BridgeDrawing from '../components/BridgeDrawing.astro';
import { getCollection } from 'astro:content';
import { url, hasValue } from '../lib/url';
import { listJoin, projectSentence, season } from '../lib/text';
import Cutout from '../components/Cutout.astro';
import site from '../data/site.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = projects[0];
const stats = site.stats.filter((s) => hasValue(s.value));
const [leadPhoto, ...restPhotos] = latest?.data.photos ?? [];
const galleryTilts = [-3, 2, -1.5, 2.5, -2];
const when = latest ? season(latest.data) : '';
const older = projects.slice(1, 3);
---

<Base revealNav>
  <!-- HERO: a full-screen photo (heroImage in site.json) with the headline over it.
       The site header stays hidden until the visitor scrolls. -->
  <section class:list={['hero', { 'no-photo': !site.heroImage }]}>
    {site.heroImage && <img class="hero-img" src={url(site.heroImage)} alt={site.heroImageAlt} />}
    <p class="hero-mark">
      {site.logo && <img class="hero-logo" src={url(site.logo)} alt="" width="72" height="60" />}
      <span class="hero-mark-name">Engineers in Action</span>
      <span class="hero-mark-chapter">Washington Chapter</span>
    </p>
    <div class="hero-bottom">
      <h1>Bridges that get people there.</h1>
      <div class="hero-links">
        <a href={url('/sponsor')}>Sponsor us</a>
        <a href={url('/join')}>Join the team</a>
        <a href={url('/bridges')}>Past bridges</a>
      </div>
      <a class="hero-scroll" href="#intro">Scroll down</a>
    </div>
  </section>

  <!-- INTRO: tagline and the bridge sketch, which draws itself when it scrolls into view -->
  <section id="intro" class="intro">
    <div class="wrap">
      <p class="intro-lede">{site.tagline}</p>
      <div class="intro-drawing">
        <BridgeDrawing span={latest?.data.spanMeters} />
      </div>
    </div>
  </section>

  <!-- PURPOSE -->
  <section id="purpose" class="band">
    <div class="wrap split">
      <div>
        <h2>A river shouldn't decide whether you get to school.</h2>
        <p class="lede">{site.purpose}</p>
        {
          stats.length > 0 && (
            <p class="stats-line">
              So far we have{' '}
              {listJoin(stats.map((s) => s.phrase.replace('{value}', s.value)))}.
            </p>
          )
        }
      </div>
      <div class="collage">
        {older.map((p, i) => (
          <a class="collage-link" href={url(`/bridges/${p.id}`)}>
            <Photo src={p.data.cover} caption={`${p.data.title.replace(' Suspended Bridge', '')}, ${p.data.date.getUTCFullYear()}`} tilt={i ? 2.5 : -3} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST PROJECT -->
  {
    latest && (
      <section id="latest">
        <div class="wrap">
          <h2>Our most recent bridge</h2>
          <div class="stagger">
            <div class="stagger-row">
              <Photo src={leadPhoto?.src} caption={leadPhoto?.caption} tilt={-2} ratio="3 / 2" />
              <div>
                <h3>{latest.data.title}</h3>
                <p class="note">{latest.data.community}, {latest.data.country}, {when}</p>
                <p>{projectSentence(latest.data)}</p>
                <a class="text-link" href={url(`/bridges/${latest.id}`)}>Read the full story</a>
              </div>
            </div>

            {(restPhotos.length > 0 || latest.data.quotes.length > 0) && (
              <div class="stagger-row">
                {latest.data.cutout ? (
                  <div class="cutout-spot">
                    <Cutout src={latest.data.cutout} alt={latest.data.cutoutAlt} tilt={-2} width="100%" />
                    <p class="note">The {latest.data.date.getUTCFullYear()} travel team</p>
                  </div>
                ) : (
                  <div class="photo-pair">
                    {restPhotos.slice(0, 2).map((p, i) => (
                      <Photo src={p.src} caption={p.caption} tilt={i ? 2.5 : -1.5} />
                    ))}
                  </div>
                )}
                <div class="quotes">
                  {latest.data.quotes.map((q) => (
                    <blockquote>
                      <p>“{q.text}”</p>
                      <cite>
                        {q.name}
                        {q.role && <span>{q.role}</span>}
                      </cite>
                    </blockquote>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- CALLS TO ACTION -->
  <section class="band">
    <div class="wrap cta">
      <div>
        <h2>Come build with us</h2>
        <p>
          You don't need an engineering background, because we also need designers, writers,
          fundraisers, and planners.
        </p>
        <a class="btn" href={url('/join')}>Join the team</a>
      </div>
      <div>
        <h2>Fund the next bridge</h2>
        <p>
          Sponsors and donors pay for every bridge we build, and the sponsor page breaks down
          where that money goes.
        </p>
        <a class="btn" href={url('/sponsor')}>Sponsor a bridge</a>
      </div>
    </div>
  </section>

  <!-- PHOTO COLLAGE: edit `gallery` in site.json -->
  <section class="gallery-section" aria-label="Photos from the team">
    <div class="wrap gallery">
      {site.gallery.map((g, i) => (
        <Photo src={g.src} caption={g.caption} tilt={galleryTilts[i % galleryTilts.length]} tape={i % 2 === 0} />
      ))}
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    padding: 28px var(--gutter) 32px;
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(22, 50, 74, 0.45) 0%, rgba(22, 50, 74, 0) 22%),
      linear-gradient(0deg, rgba(22, 50, 74, 0.9) 0%, rgba(22, 50, 74, 0.55) 32%, rgba(22, 50, 74, 0) 58%);
  }
  /* Until a hero photo exists: dark river blue with a faint diagonal texture. */
  .hero.no-photo { background: var(--ink); }
  .hero.no-photo::before {
    background: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.03) 0 14px, transparent 14px 28px);
  }
  .hero-mark { display: flex; flex-direction: column; align-items: center; margin: 0; max-width: none; }
  .hero-logo { width: 72px; height: auto; margin-bottom: 8px; filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35)); }
  .hero-img { object-position: 50% 35%; }
  .hero-mark-name { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.01em; }
  .hero-mark-chapter { font-family: var(--font-hand); font-size: 1rem; opacity: 0.85; }
  .hero-bottom { display: flex; flex-direction: column; align-items: center; text-shadow: 0 2px 18px rgba(10, 25, 40, 0.5); }
  .hero-mark { text-shadow: 0 1px 10px rgba(10, 25, 40, 0.6); }
  /* On wide screens, sit the headline in the bottom left so it covers less of the photo. */
  @media (min-width: 900px) {
    .hero { align-items: stretch; }
    .hero-bottom { align-items: flex-start; text-align: left; width: 100%; max-width: var(--max); margin: 0 auto; }
    .hero h1 { font-size: clamp(3rem, 6.5vw, 5.25rem); }
    .hero-links { justify-content: flex-start; }
  }
  .hero h1 { color: var(--paper); max-width: 14ch; margin-bottom: 0.35em; }
  .hero-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; }
  .hero-links a, .hero-scroll { color: var(--paper); font-weight: 500; }
  .hero-links a:hover, .hero-scroll:hover { background: none; color: var(--yellow); }
  .hero-scroll {
    margin-top: 36px;
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 1.05rem;
    text-decoration: none;
  }

  /* Intro */
  .intro { scroll-margin-top: 64px; }
  .intro-lede {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }
  .intro-drawing { margin-top: clamp(40px, 7vw, 80px); }

  /* Purpose */
  #purpose h2 { max-width: 14ch; }
  .stats-line { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.25; }
  .collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  .collage > :last-child { margin-top: 48px; }
  .collage-link { text-decoration: none; color: inherit; }
  .collage-link:hover { background: none; }
  .cutout-spot { display: flex; flex-direction: column; align-items: center; max-width: 440px; margin: 0 auto; }
  .cutout-spot .note { margin-top: 12px; }

  /* Latest bridge */
  .stagger { margin-top: 32px; }
  .note { margin: 0 0 16px; }
  .photo-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  .photo-pair > :last-child { margin-top: 40px; }
  .quotes { display: grid; gap: 28px; }
  blockquote { margin: 0; }
  blockquote p {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 8px;
  }
  cite { font-style: normal; font-weight: 500; display: flex; flex-direction: column; }
  cite span { font-weight: 400; color: var(--steel); font-size: 0.95rem; }

  /* Calls to action */
  .cta {
    display: grid;
    gap: 56px clamp(32px, 6vw, 96px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 860px) { .cta { grid-template-columns: 1fr 1fr; } }
  .cta h2 { font-size: var(--step-3); }
  .cta p { color: var(--steel); max-width: 40ch; margin-bottom: 24px; }

  /* Collage */
  .gallery-section { padding-top: clamp(48px, 8vw, 96px); }
  .gallery {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
  }
  @media (min-width: 860px) {
    .gallery { grid-template-columns: repeat(5, 1fr); }
    .gallery > :nth-child(even) { margin-top: 56px; }
  }
</style>
