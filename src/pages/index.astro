---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { getCollection } from 'astro:content';
import { url, hasValue } from '../lib/url';
import site from '../data/site.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = projects[0];
const stats = site.stats.filter((s) => hasValue(s.value));
const [leadPhoto, ...restPhotos] = latest?.data.photos ?? [];
const galleryTilts = [-3, 2, -1.5, 2.5, -2];
---

<Base>
  <!-- HERO: full-bleed photo with the headline over it. Set heroImage in site.json. -->
  <section class:list={['hero', 'on-photo', { 'no-photo': !site.heroImage }]}>
    {site.heroImage && <img class="hero-img" src={url(site.heroImage)} alt={site.heroImageAlt} />}
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1>
        bridges that<br />
        <span class="underline">get people</span> there.
      </h1>
      <p class="hero-lede">{site.tagline}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/sponsor')}>sponsor us</a>
        <a class="link-arrow" href={url('/join')}>join the team</a>
        <a class="link-arrow" href={url('/bridges')}>past bridges</a>
      </div>
      <a class="scroll hand" href="#purpose">scroll down ↓</a>
    </div>
  </section>

  <!-- PURPOSE -->
  <section id="purpose">
    <div class="wrap split">
      <div>
        <span class="eyebrow">what we do</span>
        <h2>a river shouldn't decide if you get to school.</h2>
        <p class="lede">{site.purpose}</p>
        {
          stats.length > 0 && (
            <div class="stats">
              {stats.map((s) => <div class="stat"><strong>{s.value}</strong><span>{s.label}</span></div>)}
            </div>
          )
        }
      </div>
      <div class="collage">
        <Photo src={latest?.data.cover} caption="the crossing before" tilt={-3} />
        <Photo src={leadPhoto?.src} caption="and after" tilt={2.5} />
      </div>
    </div>
  </section>

  <!-- LATEST PROJECT -->
  {
    latest && (
      <section id="latest" class="band">
        <div class="wrap">
          <span class="eyebrow">our most recent project</span>
          <h2>{latest.data.title}</h2>
          <p class="where">
            {latest.data.community}, {latest.data.country} ·{' '}
            {latest.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}
          </p>

          <div class="stagger">
            <div class="stagger-row">
              <Photo src={leadPhoto?.src} caption={leadPhoto?.caption} tilt={-2} ratio="3 / 2" />
              <div>
                <div class="stats">
                  {latest.data.peopleServed && (
                    <div class="stat">
                      <strong>{latest.data.peopleServed.toLocaleString()}</strong>
                      <span>people served</span>
                    </div>
                  )}
                  {latest.data.spanMeters && (
                    <div class="stat">
                      <strong>{latest.data.spanMeters}m</strong>
                      <span>span</span>
                    </div>
                  )}
                  {latest.data.travelers.length > 0 && (
                    <div class="stat">
                      <strong>{latest.data.travelers.length}</strong>
                      <span>students traveled</span>
                    </div>
                  )}
                </div>
                {latest.data.travelers.length > 0 && (
                  <p class="travelers">
                    <span class="hand">who went:</span> {latest.data.travelers.join(', ')}
                  </p>
                )}
                <a class="link-arrow right" href={url(`/bridges/${latest.id}`)}>read the full story</a>
              </div>
            </div>

            {(restPhotos.length > 0 || latest.data.quotes.length > 0) && (
              <div class="stagger-row">
                <div class="photo-pair">
                  {restPhotos.slice(0, 2).map((p, i) => (
                    <Photo src={p.src} caption={p.caption} tilt={i ? 2.5 : -1.5} />
                  ))}
                </div>
                <div class="quotes">
                  {latest.data.quotes.map((q) => (
                    <blockquote>
                      <p>“{q.text}”</p>
                      <cite>
                        <span class="hand">{q.name}</span>
                        {q.role && <small>{q.role}</small>}
                      </cite>
                    </blockquote>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="cta">
    <div class="wrap split">
      <div>
        <span class="eyebrow">come build with us</span>
        <h2>no engineering experience required.</h2>
        <p>We need designers, writers, fundraisers, planners, and people who just want to help.</p>
        <a class="link-arrow" href={url('/join')}>join the team</a>
      </div>
      <div>
        <span class="eyebrow">for sponsors</span>
        <h2>help us fund the next bridge.</h2>
        <p>Sponsors and donors pay for every bridge we build, and the sponsor page shows where that money goes.</p>
        <a class="btn btn-primary" href={url('/sponsor')}>sponsor us</a>
      </div>
    </div>
  </section>

  <!-- PHOTO COLLAGE: edit `gallery` in site.json -->
  <section class="gallery-section" aria-label="Photos">
    <div class="wrap gallery">
      {site.gallery.map((g, i) => (
        <Photo src={g.src} caption={g.caption} tilt={galleryTilts[i % galleryTilts.length]} tape={i % 2 === 0} />
      ))}
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: flex-end;
    padding: 0 0 clamp(48px, 8vw, 96px);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 26, 38, 0.15) 0%, rgba(20, 26, 38, 0.65) 100%);
  }
  /* Until a hero photo exists, use a dark backdrop with a faint diagonal texture. */
  .hero.no-photo { background: var(--navy); }
  .hero.no-photo .hero-shade {
    background: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.03) 0 14px, transparent 14px 28px);
  }
  .hero h1 { max-width: 14ch; color: var(--paper); }
  .underline {
    position: relative;
    z-index: 0;
    white-space: nowrap;
  }
  .underline::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0.05em;
    height: 0.24em;
    background: var(--accent);
    opacity: 0.8;
    border-radius: 40% 60% 50% 50%;
    transform: rotate(-1.2deg);
    z-index: -1;
  }
  .hero-lede { font-size: 1.25rem; max-width: 42ch; margin: 18px 0 28px; opacity: 0.92; }
  .scroll {
    display: inline-block;
    margin-top: 40px;
    text-decoration: none;
    color: var(--paper);
    font-size: 1.5rem;
  }

  /* Purpose */
  .collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  .collage > :last-child { margin-top: 48px; }
  .stats { margin-top: 8px; }

  /* Latest project */
  .where { color: var(--ink-soft); font-weight: 500; }
  .travelers { margin: 24px 0; }
  .travelers .hand { font-size: 1.5rem; margin-right: 6px; }
  .photo-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  .photo-pair > :last-child { margin-top: 40px; }
  .quotes { display: grid; gap: 20px; }
  blockquote {
    margin: 0;
    padding: 0 0 0 20px;
    border-left: 3px solid var(--accent);
  }
  blockquote p { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.35; font-weight: 300; }
  cite { font-style: normal; display: flex; flex-direction: column; }
  cite .hand { font-size: 1.5rem; }
  cite small { color: var(--ink-soft); }

  /* CTA */
  .cta .split { align-items: start; }
  @media (min-width: 860px) { .cta .split { grid-template-columns: 1fr 1fr; } }
  .cta h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
  .cta p { color: var(--ink-soft); max-width: 40ch; margin-bottom: 20px; }

  /* Collage */
  .gallery-section { padding-top: 0; }
  .gallery {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
  }
  @media (min-width: 860px) {
    .gallery { grid-template-columns: repeat(5, 1fr); }
    .gallery > :nth-child(even) { margin-top: 56px; }
  }
</style>
