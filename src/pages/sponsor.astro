---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title="Sponsor us" description="Sponsor Engineers in Action at UW and help fund footbridges for rural communities.">
  <section>
    <div class="wrap">
      <span class="eyebrow">sponsor us</span>
      <h1>help us build<br />the next bridge.</h1>
      <p class="lede">
        Sponsorships pay for materials, travel, and tools. In return your company gets in
        front of UW engineering students and a story worth telling.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={site.sponsorPackageUrl} target="_blank" rel="noopener">view the sponsorship package</a>
        <a class="btn" href={`mailto:${site.email}?subject=Sponsoring%20EIA%20UW`}>email us</a>
      </div>
    </div>
  </section>

  {
    site.sponsorPackageEmbedUrl && (
      <section class="band">
        <div class="wrap">
          <div class="embed">
            <iframe
              src={site.sponsorPackageEmbedUrl}
              title="EIA UW sponsorship package"
              loading="lazy"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  h1 { max-width: 14ch; }
  .lede { margin-bottom: 28px; }
  .embed {
    position: relative;
    width: 100%;
    aspect-ratio: 8.5 / 11;
    max-width: 820px;
    margin: 0 auto;
    background: #fff;
    box-shadow: 0 16px 40px -18px rgba(29, 36, 51, 0.4);
  }
  .embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
