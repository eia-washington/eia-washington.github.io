---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title="Sponsor us" description="Sponsor Engineers in Action at UW and help fund footbridges for rural communities.">
  <section>
    <div class="wrap">
      <h1>Help us build the next bridge.</h1>
      <p class="lede">
        Sponsorships pay for the materials, travel, and tools that a footbridge needs. In
        return, your company gets in front of UW engineering students who have designed and
        built real infrastructure.
      </p>
      <div class="actions">
        <a class="btn" href={site.sponsorPackageUrl} target="_blank" rel="noopener">View the sponsorship package</a>
        <a class="text-link" href={`mailto:${site.email}?subject=Sponsoring%20EIA%20UW`}>Email us about sponsoring</a>
      </div>
    </div>
  </section>

  <section id="where" class="band">
    <div class="wrap">
      <h2>Where the money goes</h2>
      <div class="columns">
        {
          site.sponsorUses.map((u) => (
            <div>
              <h3>{u.title}</h3>
              <p>{u.text}</p>
              {u.share && <p class="note share">{u.share}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <h2>What sponsors get</h2>
      <ul class="benefits">
        {site.sponsorBenefits.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </section>

  {
    site.sponsorPackageEmbedUrl && (
      <section class="band">
        <div class="wrap">
          <div class="embed">
            <iframe
              src={site.sponsorPackageEmbedUrl}
              title="EIA UW sponsorship package"
              loading="lazy"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  h1 { max-width: 12ch; }
  .share { margin-top: 12px; }
  .benefits { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; }
  .benefits li {
    padding-left: 22px;
    border-left: 3px solid var(--yellow);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .embed {
    position: relative;
    width: 100%;
    aspect-ratio: 8.5 / 11;
    max-width: 820px;
    margin: 0 auto;
    background: var(--white);
    box-shadow: 0 16px 40px -18px rgba(22, 50, 74, 0.4);
  }
  .embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
