---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Cutout from '../components/Cutout.astro';
import site from '../data/site.json';
import committees from '../data/committees.json';
import dayToDay from '../data/dayToDay.json';
import { isSet } from '../lib/url';

// Until the interest form link is set in site.json, the button emails the chapter instead.
const formReady = isSet(site.interestFormUrl);
const joinHref = formReady
  ? site.interestFormUrl
  : `mailto:${site.email}?subject=Joining%20EIA%20UW`;
const joinLabel = formReady ? 'Fill out the interest form' : 'Email us to join';
const socials = site.socials.filter((s) => isSet(s.url));
const tilts = [-2, 2, -1.5, 2.5];
---

<Base title="Join the team" description="Join Engineers in Action at UW: what a week looks like, our committees, and how to get involved.">
  <section>
    <div class="wrap split">
      <div>
        <h1>You don't need to be an engineer to build a bridge.</h1>
        <p class="lede">
          Students from any major and any year can join, and we teach the technical parts as
          we go. {formReady
            ? "Fill out the interest form and we'll invite you to the next meeting."
            : "Send us an email and we'll invite you to the next meeting."}
        </p>
        <div class="actions">
          <a class="btn" href={joinHref} target={formReady ? '_blank' : undefined} rel="noopener">{joinLabel}</a>
          {formReady && <a class="text-link" href={`mailto:${site.email}`}>Email us a question</a>}
        </div>
      </div>
      <div class="hero-cutout">
        <Cutout src={site.joinCutout} alt="EIA UW members" tilt={-3} width="360px" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>What a week looks like</h2>
      <div class="columns">
        {
          dayToDay.map((d) => (
            <div>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Committees</h2>
      <p class="lede">Most members join one committee, and you can switch at any time.</p>
      <div class="stagger">
        {
          committees.map((c, i) => (
            <div class="stagger-row">
              <Photo src={c.photo} caption={`The ${c.name.toLowerCase()} committee`} tilt={tilts[i % tilts.length]} ratio="3 / 2" />
              <div>
                <h3>{c.name}</h3>
                <p>{c.blurb}</p>
                {c.commitment && <p class="note">{c.commitment}</p>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div>
        <h2>Questions</h2>
        <p>
          Email us at <a href={`mailto:${site.email}`}>{site.email}</a>{socials.length > 0 && ' or message us on social media'},
          and someone from the team will get back to you.
        </p>
        {
          socials.length > 0 && (
            <ul class="contact">
              {socials.map((s) => <li><a class="text-link" href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
            </ul>
          )
        }
      </div>
      <div>
        <a class="btn" href={joinHref} target={formReady ? '_blank' : undefined} rel="noopener">{joinLabel}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { max-width: 13ch; font-size: var(--step-4); }
  .hero-cutout { display: flex; justify-content: center; }
  .contact { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 18px 28px; margin-top: 16px; }
</style>
