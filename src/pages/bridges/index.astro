---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Past bridges" description="Every suspended footbridge the Washington Chapter of Engineers in Action has built in Bolivia.">
  <section>
    <div class="wrap">
      <h1>Past bridges</h1>
      <p class="lede">Our chapter has designed a suspended footbridge in Bolivia every year since 2024, and each one was built with the community that uses it.</p>
      <div class="list">
        {
          projects.map((p, i) => (
            <a class="item" href={url(`/bridges/${p.id}`)}>
              <Photo src={p.data.cover || p.data.photos[0]?.src} tilt={i % 2 ? 1.5 : -1.5} />
              <div>
                <h2>{p.data.title}</h2>
                <p class="note">{p.data.community}, {p.data.country}, Summer {p.data.date.getUTCFullYear()}</p>
                <p>{p.data.summary}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .list { display: grid; gap: 64px; margin-top: 48px; }
  .item {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
  }
  @media (min-width: 760px) { .item { grid-template-columns: 360px 1fr; } }
  .item h2 { font-size: clamp(1.8rem, 3.5vw, 2.5rem); }
  .item:hover { background: none; }
  .item:hover h2 { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 3px; }
  .item p { color: var(--steel); }
</style>
