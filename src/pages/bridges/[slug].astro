---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';
import { listJoin, projectSentence } from '../../lib/text';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const tilts = [-2, 1.5, -1, 2.5];
---

<Base title={d.title} description={d.summary}>
  <section>
    <div class="wrap">
      <a class="back text-link" href={url('/bridges')}>All past bridges</a>
      <h1>{d.title}</h1>
      <p class="note">{d.community}, {d.country}, {d.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</p>
      <p class="lede">{projectSentence({ ...d, travelers: [] })}</p>
    </div>
  </section>

  {
    d.photos.length > 0 && (
      <section class="band">
        <div class="wrap photos">
          {d.photos.map((p, i) => <Photo src={p.src} caption={p.caption} tilt={tilts[i % tilts.length]} />)}
        </div>
      </section>
    )
  }

  <section>
    <div class="wrap prose">
      <p class="summary">{d.summary}</p>
      <Content />
    </div>
  </section>

  {
    d.quotes.length > 0 && (
      <section class="band">
        <div class="wrap quotes">
          {d.quotes.map((q) => (
            <blockquote>
              <p>“{q.text}”</p>
              <cite>{q.name}{q.role && <span>{q.role}</span>}</cite>
            </blockquote>
          ))}
        </div>
      </section>
    )
  }

  {
    d.travelers.length > 0 && (
      <section>
        <div class="wrap">
          <h2>The travel team</h2>
          <p class="lede">{listJoin(d.travelers)} traveled to build this bridge.</p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .back { display: inline-block; margin-bottom: 28px; }
  h1 { max-width: 14ch; }
  .note { margin-bottom: 20px; }
  .photos {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .summary { font-size: var(--step-1); font-family: var(--font-display); line-height: 1.45; }
  .quotes {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  blockquote { margin: 0; padding-left: 20px; border-left: 3px solid var(--yellow); }
  blockquote p { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.4; margin-bottom: 8px; }
  cite { font-style: normal; font-weight: 500; display: flex; flex-direction: column; }
  cite span { font-weight: 400; color: var(--steel); font-size: 0.95rem; }
</style>
