---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import people from '../data/people.json';

// Group people by team, keeping the order teams first appear in people.json.
const teams = [...new Set(people.map((p) => p.team || 'Members'))];
---

<Base title="People" description="Meet the students behind Engineers in Action at UW.">
  <section>
    <div class="wrap">
      <h1>The people behind the bridges</h1>
      <p class="lede">These are the students who run Engineers in Action at UW this year, grouped by committee.</p>
    </div>
  </section>

  {
    teams.map((team, t) => (
      <section class:list={['team', { band: t % 2 === 0 }]}>
        <div class="wrap">
          <h2>{team}</h2>
          <div class="grid">
            {people
              .filter((p) => (p.team || 'Members') === team)
              .map((p, i) => (
                <PersonCard person={p} index={i} />
              ))}
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  h1 { max-width: 12ch; }
  .team { padding: clamp(40px, 6vw, 72px) 0; }
  .team h2 { font-size: var(--step-3); }
  .grid {
    display: grid;
    gap: 40px 24px;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    margin-top: 24px;
  }
</style>
